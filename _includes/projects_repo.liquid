<div class="col">
  <div class="card hoverable">
    {% if include.repo.img %}
      {%
        include figure.liquid
        loading="eager"
        path=include.repo.img
        sizes = "250px"
        alt="project thumbnail"
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">{{ include.repo.title | default: include.repo.name }}</h2>
      {% if include.repo.page %}
        <a class="btn btn-sm btn-primary mb-3" href="{{ include.repo.page | relative_url }}">Project page</a>
      {% endif %}
      {% if include.repo.github %}
        <a class="btn btn-sm btn-outline-primary mb-3" href="{{ include.repo.github }}" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      {% endif %}
      <p class="card-text">{{ include.repo.description | default: "Featured GitHub repository" }}</p>
      {% if include.repo.tags %}
        <div class="repo-tags">
          {% for tag in include.repo.tags %}
            <span class="repo-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    {% if include.repo.where or include.repo.when %}
      <div class="repo-stub">
        <span class="repo-stamp">
          <i class="fa-solid fa-graduation-cap"></i>
          {{ include.repo.where }}
          {%- if include.repo.where and include.repo.when %} · {% endif -%}
          {{ include.repo.when }}
        </span>
      </div>
    {% endif %}
  </div>
</div>