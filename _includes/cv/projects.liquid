{% comment %}
  Unified projects entry renderer for both formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      {% capture project_date %}{% if entry.startDate %}{{ entry.startDate | date: "%b %Y" }}{% elsif entry.date %}{{ entry.date }}{% endif %}{% endcapture %}
      <h6 class="title font-weight-bold">
        {% if entry.url %}
          <a href="{{ entry.url | relative_url }}">{{ entry.name }}</a>
        {% else %}
          {{ entry.name }}
        {% endif %}
        {% if project_date != '' %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle ml-2">{{ project_date }}</span>
        {% endif %}
      </h6>

      {% if entry.summary %}
        <p>{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
      {% endif %}

      {% if entry.highlights %}
        <ul class="items">
          {% for item in entry.highlights %}
            <li>
              <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
